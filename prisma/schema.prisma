generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER
}

enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum JobPosition {
  JUNIOR
  MIDDLE
  SENIOR
  STAFF
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  jobs         Job[]
}

model Job {
  id          String      @id @default(uuid())
  title       String
  position    JobPosition @default(JUNIOR)
  experience  String
  description String      @db.Text
  status      JobStatus   @default(QUEUED)
  progress    Int         @default(0)
  createdById String
  creator     User        @relation(fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  completedAt DateTime?

  @@index([status])
  @@index([position])
  @@index([createdById])
  @@index([createdAt])
  @@index([status, position]) // composite — matches your most common combined filter
}